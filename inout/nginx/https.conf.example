# ================================================================
# INOUT Nginx HTTPS 설정 예시 — PWA(홈 화면 설치·서비스 워커·푸시)는 HTTPS에서만 동작한다.
#
# 사용 방법은 DEPLOY.md "10. HTTPS 적용"을 따른다. 요약:
#   1) 도메인 A 레코드를 EC2 공인 IP로 연결
#   2) certbot으로 인증서 발급 (/etc/letsencrypt/live/<도메인>/)
#   3) 이 파일의 ${DOMAIN}을 실제 도메인으로 바꿔 nginx/default.conf 자리에 넣고,
#      docker-compose frontend 서비스에 443 포트와 /etc/letsencrypt, /var/www/certbot 마운트를 추가
#
# 아래 location 블록은 default.conf와 같다. default.conf를 고치면 이 파일도 함께 고친다.
# ================================================================

upstream inout_backend {
    server backend:8080;
}

# ── HTTP(80): 인증서 갱신용 경로만 열고 나머지는 HTTPS로 보낸다 ──
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # 브라우저가 앞으로 이 도메인은 HTTPS로만 접속하게 한다 (처음 적용 후 문제없음을 확인하고 max-age를 늘린다)
    add_header Strict-Transport-Security "max-age=86400" always;

    client_max_body_size 20M;   # 상품 이미지 / 문의 첨부파일 업로드 허용 크기

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 1024;

    # ── React SPA 정적 파일 ──────────────────────────────────
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── PWA ──────────────────────────────────────────────────
    # 서비스 워커·매니페스트는 바뀌면 바로 반영돼야 하므로 캐시하지 않는다.
    # (정확히 일치(=)하는 location이 아래 확장자 정규식보다 먼저 적용된다)
    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Service-Worker-Allowed "/";
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # 해시가 포함된 빌드 산출물(js/css 등)은 장기 캐시, index.html은 매번 재검증
    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    # ── 백엔드 REST API ───────────────────────────────────────
    location /api/ {
        proxy_pass http://inout_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── 업로드 파일(상품 이미지 등 공개 정적 자원) ────────────
    # 백엔드 WebConfig의 "/uploads/**" 매핑(permitAll)과 대응된다.
    location /uploads/ {
        proxy_pass http://inout_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── React SPA OAuth2 콜백 (정적 파일) ────────────────────
    # /oauth2/callback?accessToken=... 는 프론트엔드 라우트(OAuth2CallbackPage)다.
    # 아래 exact-match(=)가 prefix-match(/oauth2/)보다 우선하므로 SPA index.html을 돌려준다.
    location = /oauth2/callback {
        try_files $uri /index.html;
    }

    # ── OAuth2 소셜 로그인 시작(인가) 요청 ────────────────────
    location /oauth2/ {
        proxy_pass http://inout_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── OAuth2 소셜 플랫폼 → 서버 콜백 ────────────────────────
    location /login/oauth2/ {
        proxy_pass http://inout_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── 컨테이너/로드밸런서 헬스체크 ──────────────────────────
    location /actuator/health {
        proxy_pass http://inout_backend;
        proxy_set_header Host $host;
    }
}
