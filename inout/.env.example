# ================================================================
# INOUT 운영 배포 환경 변수 템플릿
#
# 사용법:
#   1) 이 파일을 복사해 EC2 서버에서만 ".env" 파일을 생성한다.
#        cp .env.example .env
#   2) 아래 값들을 실제 운영 값으로 채운다 (특히 change-me로 표시된 항목은 반드시 교체).
#   3) docker compose --env-file .env up -d 로 기동한다.
#
# ⚠️ .env 파일 자체는 절대 git에 커밋하지 않는다. (.gitignore에 반드시 포함되어야 함)
# ================================================================

# ───────────────────────────────
# 1. Spring 프로파일
# ───────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ───────────────────────────────
# 2. 데이터베이스 (MySQL)
# ───────────────────────────────
MYSQL_DATABASE=inout
MYSQL_USER=inout_user
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# docker-compose 내부 네트워크에서는 서비스명(mysql)으로 접속한다.
# rewriteBatchedStatements=true — MassDataGeneratorService 등 JdbcTemplate.batchUpdate() 대량 삽입 성능 최적화 (MySQL 표준 옵션)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/inout?useUnicode=true&characterEncoding=utf8&characterSetResults=utf8&serverTimezone=UTC&rewriteBatchedStatements=true
SPRING_DATASOURCE_USERNAME=inout_user
SPRING_DATASOURCE_PASSWORD=change-me-strong-password

# [최초 배포 스키마 생성 가이드 — application-prod.properties 주석 참고]
# 스키마가 없는 최초 배포 시에만 아래 주석을 해제해 "update"로 1회 기동 후,
# 테이블 생성이 확인되면 반드시 다시 주석 처리(또는 값 삭제)하고 재기동할 것.
# DDL_AUTO=update

# ───────────────────────────────
# 3. JWT
# ───────────────────────────────
# Base64 인코딩된 32바이트 이상 키, 또는 64자 이상 hex 문자열이어야 한다.
# 생성 예시: openssl rand -base64 32
JWT_SECRET=change-me-generate-a-real-secret-key

# ───────────────────────────────
# 4. Redis
# ───────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# ───────────────────────────────
# 5. 도메인 / CORS / OAuth2 리다이렉트
# ───────────────────────────────
APP_SERVER_URL=https://your-production-domain.com
APP_FRONTEND_URL=https://your-production-domain.com
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# ───────────────────────────────
# 6. 메일 (카카오 SMTP 앱 비밀번호)
# ───────────────────────────────
SPRING_MAIL_PASSWORD=change-me-kakao-app-password

# ───────────────────────────────
# 7. Gemini AI API 키 (선택 — 미설정 시 아래 3개 AI 기능만 비활성화되고 나머지는 정상 동작)
#    ① AI 운영 인사이트 리포트 (수동, GET /api/admin/ai/insight)
#    ② AI 고객 문의(CS) 자동 분류·답변 초안 생성 (AiCsScheduler, 10분마다 KST 기준 자동 실행)
#    ③ AI 지능형 재고 분석·자동 발주 제안 (AiAutoOrderScheduler, 매일 자정 KST 기준 자동 실행)
#    3개 기능 모두 이 키 하나를 공유한다. 발급: https://aistudio.google.com/apikey
# ───────────────────────────────
GEMINI_API_KEY=

# ───────────────────────────────
# 8. OAuth2 소셜 로그인
#    각 플랫폼 개발자 콘솔에 아래 콜백 URI를 등록해야 한다.
#    https://your-production-domain.com/login/oauth2/code/{google|kakao|naver}
#
#    Google: HTTPS 도메인이 연결된 뒤 실제 키를 채우면 즉시 활성화된다.
#      - IP 전용 1차 배포 시에는 비워 둬도 된다 (application-prod.properties에
#        :GOOGLE_DUMMY_CLIENT_ID 기본값이 있어 기동은 정상 진행됨).
#      - Google Cloud Console에서 승인된 리다이렉트 URI:
#          https://your-domain.com/login/oauth2/code/google
#      - 키를 채운 뒤 LoginPage.jsx의 google provider enabled 값은 이미 true이므로
#        별도 코드 변경 없이 즉시 동작한다.
#    Kakao(사업자등록 전이라 이메일 동의항목 미확보)/Naver(검수 대기)는 프론트 로그인 페이지에서
#    아직 "준비중" 배지로 막아뒀으므로 지금은 비워둬도 된다(application-prod.properties에
#    :not-configured 기본값이 있어 기동에 영향 없음). 발급받는 대로 여기 채우고
#    frontend/src/pages/LoginPage.jsx의 OAUTH_PROVIDERS에서 해당 provider의 enabled를
#    true로 바꾸면 된다.
# ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ───────────────────────────────
# 9. 파일 업로드 경로 (컨테이너 내부 경로 — docker-compose 볼륨 마운트 대상)
#    ImageService(상품 이미지) / InquiryService(문의 첨부파일) 모두 이 경로를 공유한다.
# ───────────────────────────────
UPLOAD_PATH=/app/uploads
